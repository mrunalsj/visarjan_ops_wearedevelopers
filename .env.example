PORT=4173
DEMO_MODE=true
# DATA_DIR=./data
# Fictional bookable demo sites (Pune + Bengaluru) are shown by default; set false to hide them
# DEMO_SITES=false
# Secret for deriving pass check-in codes (optional; otherwise generated into the local data store)
# PASS_SIGNING_SECRET=
# Reserved for a future authorised live status feed. Not fetched; no feed is connected.
# SITE_STATUS_FEED_URL=

# Flagsmith (official @flagsmith/nodejs SDK, local evaluation). Server-side environment key, starts with "ser.".
# Keep it secret: never put it in browser code. Without it, safe defaults apply (new features off).
FLAGSMITH_SERVER_KEY=
# Fallback values used only while Flagsmith is unconfigured/unreachable (Flagsmith values always win):
# FEATURE_FLAG_DEFAULTS=voice_assistance=on,ops_status_updates=on
# FLAGSMITH_API_URL=            # only for self-hosted Flagsmith, e.g. http://localhost:8000/api/v1/
# FLAGSMITH_REFRESH_SECONDS=60  # 60 s ≈ 43k requests/month, within the Free plan's 50k

# Sarvam AI voice search (spends account credits). Also needs the voice_assistance flag.
SARVAM_ENABLED=false
SARVAM_API_KEY=
# SARVAM_SPEAKER=simran_en_customer
# SARVAM_DAILY_CALL_LIMIT=150

# Read-only bearer token for monitoring (NudgeBee HTTP task) on GET /api/v1/health. At least 24 characters.
OPS_MONITOR_TOKEN=
OPS_USERNAME=site-ops
OPS_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
APIFY_API_TOKEN=
APIFY_ACTOR_ID=
APIFY_ACTOR_INPUT_JSON={}
APIFY_MAX_ITEMS=25
APIFY_MAX_TOTAL_CHARGE_USD=1
